rules_version = '2';

// Règles de sécurité Firestore — projet altimates-4c37f.
// À déployer depuis la console Firebase (Firestore > Règles) ou via `firebase deploy --only firestore:rules`.
// Le contrôle d'accès réel est ICI, pas dans le code client.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins : codés en dur À DESSEIN (ancre de sécurité). Toujours membres,
    // même si la whitelist dynamique est vide → jamais de lockout total.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'hammadou.nordine@gmail.com',
          'wacil78@gmail.com'
        ];
    }

    // Whitelist dynamique des membres, éditable depuis le panneau Admin.
    // Source de vérité : config/allowedEmails.emails (string[]).
    function allowedEmails() {
      return exists(/databases/$(database)/documents/config/allowedEmails)
        ? get(/databases/$(database)/documents/config/allowedEmails).data.get('emails', [])
        : [];
    }

    // ── Cordées multiples (modèle additif, rétrocompatible v0.5.0) ──────────
    // L'appartenance à une cordée est matérialisée par l'EXISTENCE du document
    // cordees/{cordeeId}/members/{email}. La cordée 'origine' correspond aux
    // données historiques : ses membres obtiennent l'accès aux collections
    // racines existantes via isMember(), en PLUS de la whitelist — l'app prod
    // v0.5.0 (whitelist seule) continue de fonctionner à l'identique.
    function isCordeeMember(cordeeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/cordees/$(cordeeId)/members/$(request.auth.token.email));
    }

    function isMember() {
      return request.auth != null
        && (isAdmin()
          || request.auth.token.email in allowedEmails()
          || isCordeeMember('origine'));
    }

    // Prénom du membre courant (users/{uid}.profile.name). Sert d'identité dans
    // les collections qui indexent par prénom (dépenses, transport) : sans ça,
    // n'importe qui pourrait écrire une dépense au nom d'un autre. Renvoie ''
    // si le profil n'existe pas encore, ce qui ne matche aucun prénom réel.
    function memberName() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profile', {}).get('name', '')
        : '';
    }

    // La photo de profil est une data URL stockée DANS le document users/{uid},
    // faute de Firebase Storage. Sans plafond ici, un membre pourrait y écrire
    // n'importe quelle charge utile et transformer son document en espace de
    // stockage libre — et, en dépassant la limite de 1 Mio d'un document, casser
    // toutes ses propres écritures de profil. 80 Ko laisse largement la place au
    // kit et aux stats qui vivent dans le même document.
    function validProfilePhoto() {
      return !('profile' in request.resource.data)
        || request.resource.data.profile == null
        || !('photo' in request.resource.data.profile)
        || (request.resource.data.profile.photo is string
          && request.resource.data.profile.photo.matches('^data:image/.*')
          && request.resource.data.profile.photo.size() < 80000);
    }

    // Chaque membre ne peut écrire que son propre document utilisateur.
    match /users/{userId} {
      allow read: if isMember();
      allow write: if isMember()
        && (request.auth.uid == userId || isAdmin())
        && validProfilePhoto();
    }

    // Whitelist lisible par les MEMBRES uniquement (pas par tout compte Google :
    // sinon n'importe qui d'authentifié pourrait énumérer les e-mails membres).
    // Pas de dépendance circulaire : le get() de allowedEmails() dans isMember()
    // s'exécute côté serveur et ignore les règles de lecture. Côté client, un
    // non-membre reçoit permission-denied → isMemberEmail() conclut "non autorisé".
    match /config/allowedEmails {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Disponibilités (onglet Fenêtre) : chacun ne peut écrire que son propre
    // doc (id = uid) ; lecture par tous les membres pour voir les fenêtres communes.
    match /availability/{userId} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == userId;
    }

    // Autres docs de config : lecture membres, écriture admin.
    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Idées (onglet Idées) : vote/statut/commentaires/suppression ouverts à tout
    // membre comme le reste des collections collaboratives, mais le texte et la
    // catégorie ne sont modifiables que par l'auteur (édition après soumission).
    match /feedbacks/{doc} {
      allow read, create, delete: if isMember();
      allow update: if isMember()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'cat'])
          || resource.data.author == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.name);
    }

    // Dépenses partagées d'une sortie (Tricount) : tout membre peut créer une
    // dépense ; seul celui qui a avancé l'argent (ou un admin) peut la modifier
    // ou la supprimer, sinon n'importe qui pourrait effacer la dette qu'il doit.
    match /expenses/{doc} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.payer == memberName();
      allow update, delete: if isMember()
        && (resource.data.payer == memberName() || isAdmin());
    }

    // Transport vers le départ : un doc par (rando, membre), id = randoId_membre.
    // Chacun ne déclare que son propre moyen de transport.
    match /transport/{doc} {
      allow read: if isMember();
      allow write: if isMember()
        && (isAdmin()
          || (request.method == 'delete'
            ? resource.data.member == memberName()
            : request.resource.data.member == memberName()));
    }

    // Photos post-rando : lecture pour tous les membres. À la création, TROIS
    // conditions sont vérifiées ici et pas seulement dans l'UI — masquer un
    // bouton ne protège rien :
    //  1. l'auteur déclaré est bien l'appelant (uid, jamais le prénom qui n'est
    //     pas une identité et peut être usurpé) ;
    //  2. seul l'organisateur de la rando (ou un admin) peut publier — le doc
    //     porte `randoDocId` précisément pour rendre ce get() possible, l'id
    //     métier `randoId` ne permettant pas d'adresser le document ;
    //  3. la charge est bien une image, et sous la taille maximale — sinon la
    //     collection devient un espace de stockage libre pour tout membre.
    match /randoMedia/{doc} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('^data:image/.*')
        && request.resource.data.dataUrl.size() < 400000
        && (isAdmin()
          || (exists(/databases/$(database)/documents/randos/$(request.resource.data.randoDocId))
            && get(/databases/$(database)/documents/randos/$(request.resource.data.randoDocId)).data.get('proposedBy', '') == memberName()));
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Enquête post-rando : une réponse par membre et par sortie. L'unicité est
    // garantie ICI par l'id du document, imposé à `${randoId}_${uid}` : une
    // seconde soumission ÉCRASE la première au lieu de s'ajouter (c'est ce qui
    // rend la réponse modifiable), et personne ne peut répondre au nom d'un
    // autre — c'est l'uid qui est vérifié, jamais le prénom. Réponses
    // nominatives, lisibles par tous les membres (restitution à la cordée).
    // La fenêtre de 14 jours est un calcul client assumé : la contourner ne
    // permet que de noter sa propre sortie hors délai, sans impact sécurité.
    match /randoSurveys/{doc} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.authorUid == request.auth.uid
        && doc == request.resource.data.randoId + '_' + request.auth.uid
        && request.resource.data.randoId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.organization is int
        && request.resource.data.organization >= 1
        && request.resource.data.organization <= 5
        && request.resource.data.difficulty in ['facile', 'comme-prevu', 'plus-dur']
        && request.resource.data.weather in ['soleil', 'nuageux', 'pluie', 'neige']
        // Commentaire optionnel mais borné : sans plafond, la collection
        // deviendrait un espace de stockage libre pour tout membre.
        && (!('comment' in request.resource.data)
          || (request.resource.data.comment is string
            && request.resource.data.comment.size() <= 400));
      allow delete: if isMember()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ── Cordées & parrainage ────────────────────────────────────────────────
    // Invariants appliqués ICI, jamais dans l'UI :
    //  - un lien d'invitation expire 24 h après sa création ;
    //  - un lien fait entrer 6 personnes maximum (7e usage refusé) ;
    //  - seul le CRÉATEUR du lien approuve une demande ;
    //  - un invité non approuvé ne lit et n'écrit RIEN dans la cordée ;
    //  - les données d'une cordée ne sont lisibles que par SES membres.

    // Approbation d'une demande : création de cordees/{cid}/members/{email} par
    // le créateur du lien, dans le MÊME batch que la mise à jour du quota sur
    // invites/{id}.approved (vérifié via getAfter : sans l'écriture jumelle sur
    // le lien — celle qui applique le plafond de 6 — l'ajout du membre est
    // refusé). La demande (joinRequests) a elle-même été validée à sa création :
    // lien existant, non expiré, quota non atteint.
    function approvalValid(cordeeId, memberEmail) {
      let d = request.resource.data;
      let invitePath = /databases/$(database)/documents/invites/$(d.inviteId);
      let requestPath = /databases/$(database)/documents/joinRequests/$(d.requestId);
      return d.inviteId is string
        && d.requestId is string
        && exists(invitePath)
        && get(invitePath).data.cordeeId == cordeeId
        && get(invitePath).data.createdBy == request.auth.token.email
        && exists(requestPath)
        && get(requestPath).data.inviteId == d.inviteId
        && get(requestPath).data.email == memberEmail
        && getAfter(invitePath).data.approved.hasAll([memberEmail]);
    }

    match /cordees/{cordeeId} {
      // Lisible par ses membres uniquement : un invité non approuvé (ou un
      // membre d'une AUTRE cordée) n'y voit rien. Le nom affiché à l'invité
      // vit dénormalisé dans le doc d'invitation.
      allow read: if isAdmin() || isCordeeMember(cordeeId);
      // N'importe quel utilisateur authentifié peut fonder une cordée (nombre
      // illimité par utilisateur) : une cordée vide n'expose aucune donnée,
      // et l'entrée d'autrui reste soumise au parrainage ci-dessous.
      // EXCEPTION : l'id 'origine' est réservé — ses membres accèdent aux
      // données historiques (isMember), seul un admin peut donc le créer.
      allow create: if (cordeeId != 'origine' || isAdmin())
        && request.auth != null
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60;
      allow update, delete: if isAdmin();

      match /members/{memberEmail} {
        allow read: if isAdmin() || isCordeeMember(cordeeId);
        // `email` dupliqué en champ (== id du doc) : les requêtes collectionGroup
        // "mes cordées" filtrent dessus, il doit être fiable.
        allow create: if request.resource.data.email == memberEmail
          && (isAdmin()
            // Fondateur : s'ajoute lui-même dans le batch qui crée sa cordée.
            || (request.auth != null
              && memberEmail == request.auth.token.email
              && getAfter(/databases/$(database)/documents/cordees/$(cordeeId)).data.createdBy == request.auth.token.email)
            // Entrée par parrainage, approuvée par le créateur du lien.
            || approvalValid(cordeeId, memberEmail));
        // Quitter une cordée : chacun peut retirer sa propre appartenance.
        allow delete: if isAdmin()
          || (request.auth != null && memberEmail == request.auth.token.email);
        allow update: if false;
      }

      // Données partitionnées par cordée (radio, sorties… — cartes suivantes) :
      // accessibles aux seuls membres de LA cordée. Liste explicite pour ne
      // JAMAIS englober /members (sinon tout membre pourrait s'auto-inviter).
      match /{col}/{doc} {
        allow read, write: if (isAdmin() || isCordeeMember(cordeeId))
          && col in ['randos', 'messages', 'departItems', 'ravito', 'hydra', 'feedbacks'];
      }
    }

    // Requêtes collectionGroup « mes cordées » : chacun ne peut lister que ses
    // PROPRES docs d'appartenance (where email == son e-mail), où qu'ils soient.
    match /{path=**}/members/{memberEmail} {
      allow read: if request.auth != null
        && resource.data.email == request.auth.token.email;
    }

    // Liens de parrainage. L'id du doc EST le jeton (capacité) : un `get` par id
    // est ouvert à tout utilisateur authentifié (l'invité doit voir le nom de la
    // cordée), mais le LISTAGE est réservé aux liens qu'on a soi-même créés —
    // sinon n'importe quel compte Google énumérerait tous les jetons actifs.
    match /invites/{inviteId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && resource.data.createdBy == request.auth.token.email;
      allow create: if isCordeeMember(request.resource.data.cordeeId)
        && request.resource.data.createdBy == request.auth.token.email
        // serverTimestamp exigé : l'expiration 24 h se calcule dessus, un
        // createdAt choisi par le client la rendrait contournable.
        && request.resource.data.createdAt == request.time
        && request.resource.data.approved == [];
      // Seule évolution permise : la liste `approved` qui GRANDIT (jamais de
      // retrait — sinon le quota de 6 serait réarmable), plafonnée à 6.
      allow update: if (isAdmin() || resource.data.createdBy == request.auth.token.email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is list
        && request.resource.data.approved.size() <= 6
        && request.resource.data.approved.hasAll(resource.data.approved);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.createdBy == request.auth.token.email);
    }

    // Demandes d'entrée. C'est ICI que se jouent l'expiration (24 h) et le
    // refus anticipé du 7e : passé le délai ou le quota, plus AUCUNE demande
    // ne peut être créée sur ce lien.
    match /joinRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.inviteId is string
        // Id imposé (lien_uid) : une seule demande par utilisateur et par lien,
        // pas de spam de documents à ids arbitraires.
        && requestId == request.resource.data.inviteId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.cordeeId
          == request.resource.data.cordeeId
        && request.time
          < get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.createdAt
            + duration.value(24, 'h')
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.approved.size() < 6;
      // Le demandeur suit sa propre demande ; les membres de la cordée visée la
      // voient pour l'approuver (l'approbation effective reste réservée au
      // créateur du lien, via approvalValid).
      allow read: if isAdmin()
        || (request.auth != null && resource.data.email == request.auth.token.email)
        || isCordeeMember(resource.data.cordeeId);
      // Refus = suppression, par le créateur du lien ; le demandeur peut aussi
      // retirer sa propre demande.
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.email == request.auth.token.email)
        || (request.auth != null
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteId)).data.createdBy
            == request.auth.token.email);
      allow update: if false;
    }

    // Collections collaboratives : lecture/écriture pour tous les membres.
    // NB : la collection racine `messages` (ancienne radio globale) est devenue
    // le canal radio « Broadcast » — mêmes règles, aucune migration : l'app
    // prod v0.5.0 continue d'y lire/écrire à l'identique. Les fils par cordée
    // vivent dans cordees/{cid}/messages (règle dédiée plus haut, réservée aux
    // membres de la cordée).
    match /{collection}/{doc} {
      allow read, write: if isMember()
        && collection in ['randos', 'messages', 'departItems', 'ravito', 'hydra'];
    }
  }
}
